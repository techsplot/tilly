NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_MODEL_EXTRACTION=
NEBIUS_MODEL_ANSWER=
DATABASE_URL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Nebius calls allowed per UTC day across all users (default 3000).
MODEL_DAILY_LIMIT=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Web Push (VAPID) — generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Copy VAPID_PUBLIC_KEY value here — this is exposed to the browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Format: mailto:admin@yourdomain.com
VAPID_CONTACT=

# Public HTTPS URL (required for Twilio status callbacks and Web Push)
# Use ngrok locally: ngrok http 3000 → copy the https:// URL
# Deployed: set to your production URL, e.g. https://your-app.onrender.com
APP_URL=
# Twilio Inbound SMS webhook — configure manually in Twilio Console:
#   Phone Number → Messaging → "A message comes in" → Webhook (HTTP POST)
#   URL: https://[APP_URL]/api/sms/inbound
